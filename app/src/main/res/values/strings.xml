    <string name="overview_runtime_title">Runtime overview</string>
    <string name="overview_runtime_dump_subtitle">Dump-only mode is currently enabled.</string>
    <string name="overview_runtime_hook_subtitle">Text interception mode is currently enabled.</string>
    <string name="overview_runtime_cocos_lua_subtitle">Cocos2d-x Lua probing is currently selected.</string>
    <string name="overview_runtime_dump_body">The app will only execute the Il2Cpp dump flow and will not install native text hooks.</string>
    <string name="overview_runtime_hook_body">The app prefers JSON/RVA targets and falls back to reflection-based method lookup when metadata is incomplete.</string>
    <string name="overview_runtime_cocos_lua_body">The native runtime watches Cocos engine libraries. Runtime capture installs Label/LuaBinding text hooks, and Lua replacement rules patch selected luaL_loadbuffer chunks.</string>
    <string name="overview_runtime_footer">Use the bottom tabs to switch between overview, runtime, config, and settings.</string>
    <string name="overview_flow_title">Recommended flow</string>
    <string name="overview_flow_subtitle">Keep the configuration process separated by business step.</string>
    <string name="overview_flow_body">1. Confirm runtime mode. 2. Parse and save target methods from dump.cs. 3. Check the latest release from Settings when needed. 4. Enable the module for a single target app in LSPosed.</string>

