    <string name="usage_notes_title">Usage notes</string>
    <string name="usage_notes_body">When LSPosed hooks multiple apps at the same time, only the current process receives the native hook reliably. Enable one target package at a time.</string>

    <string name="mode_dump_title">Il2Cpp dump mode</string>
    <string name="mode_dump_enabled_desc">Only performs dump generation. Text interception is skipped.</string>
    <string name="mode_dump_disabled_desc">Disables dump-only mode and keeps text interception active.</string>
    <string name="mode_engine_title">Game engine</string>
    <string name="mode_engine_subtitle">Select the runtime family before editing targets or Cocos rules.</string>
    <string name="mode_text_replacement_title">Text replacement</string>
    <string name="mode_text_replacement_enabled_desc">Hooked text is replaced with the configured test text.</string>
    <string name="mode_text_replacement_disabled_desc">Hooked text is captured without forced replacement.</string>
    <string name="mode_text_replacement_value">Replacement text</string>
    <string name="mode_text_db_reset_title">Clear text.db on startup</string>
    <string name="mode_text_db_reset_enabled_desc">The target main process deletes text.db before collecting text.</string>
    <string name="mode_text_db_reset_disabled_desc">Existing text.db content is kept and new captures are appended.</string>
    <string name="mode_cocos_lua_workflow_title">Cocos2d-x Lua workflow</string>
    <string name="mode_cocos_lua_workflow_desc">Text hooks, database persistence, replacement delay, and font replacement can be controlled separately.</string>
    <string name="mode_cocos_runtime_capture_title">Runtime text hooks</string>
    <string name="mode_cocos_runtime_capture_enabled_desc">Install Label and LuaBinding text hooks in Cocos libraries.</string>
    <string name="mode_cocos_runtime_capture_disabled_desc">Skip runtime Label and LuaBinding text hooks.</string>
    <string name="mode_cocos_text_persist_title">Write captures to text.db</string>
    <string name="mode_cocos_text_persist_enabled_desc">Eligible hooked text is saved into the target text.db.</string>
    <string name="mode_cocos_text_persist_disabled_desc">Hooked text is not written into SQLite.</string>
    <string name="mode_cocos_text_persist_chinese_only_title">Chinese-only database filter</string>
    <string name="mode_cocos_text_persist_chinese_only_enabled_desc">Only hooked text containing Chinese characters is saved.</string>
    <string name="mode_cocos_text_persist_chinese_only_disabled_desc">All eligible non-ASCII hooked text can be saved.</string>
    <string name="mode_cocos_text_replacement_delay_title">Simulate sync translation delay</string>
    <string name="mode_cocos_text_replacement_delay_enabled_desc">Delay before applying the test replacement text in Cocos text hooks.</string>
    <string name="mode_cocos_text_replacement_delay_disabled_desc">Test replacement text is applied without an artificial delay.</string>
    <string name="mode_cocos_text_replacement_delay_value">Delay milliseconds</string>
    <string name="mode_cocos_typewriter_title">Burst delay guard</string>
    <string name="mode_cocos_typewriter_enabled_desc">When many text hooks arrive in a short window, skip later simulated translation waits and apply the test text directly.</string>
    <string name="mode_cocos_typewriter_disabled_desc">Every text hook uses the synchronous replacement path.</string>
    <string name="mode_cocos_typewriter_idle_finalize_ms">Burst hold milliseconds</string>
