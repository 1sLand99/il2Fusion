    <string name="usage_notes_title">使用提示</string>
    <string name="usage_notes_body">当 LSPosed 同时勾选多个应用时，只有当前进程能稳定收到原生 hook。建议一次只启用一个目标包名。</string>

    <string name="mode_dump_title">Il2CppDumper 模式</string>
    <string name="mode_dump_enabled_desc">仅执行 dump 生成流程，不安装文本拦截。</string>
    <string name="mode_dump_disabled_desc">关闭仅 Dump 模式，保持文本拦截能力。</string>
    <string name="mode_engine_title">游戏引擎</string>
    <string name="mode_engine_subtitle">先选择运行时类型，再编辑对应的目标或配置。</string>
    <string name="mode_text_replacement_title">文案替换</string>
    <string name="mode_text_replacement_enabled_desc">hook 到的文案会被替换成下方测试文本。</string>
    <string name="mode_text_replacement_disabled_desc">当前只捕获文案，不强制替换。</string>
    <string name="mode_text_replacement_value">替换文案</string>
    <string name="mode_text_db_reset_title">启动时清空 text.db</string>
    <string name="mode_text_db_reset_enabled_desc">目标主进程启动时会先删除旧 text.db，再重新采集。</string>
    <string name="mode_text_db_reset_disabled_desc">保留已有 text.db 内容，新捕获文案继续追加。</string>
    <string name="mode_cocos_lua_workflow_title">Cocos2d-x Lua 工作流</string>
    <string name="mode_cocos_lua_workflow_desc">文本 hook、数据库写入、替换延迟和字体替换可以分别控制。</string>
    <string name="mode_cocos_runtime_capture_title">运行时文本 Hook</string>
    <string name="mode_cocos_runtime_capture_enabled_desc">在 Cocos 库中安装 Label 和 LuaBinding 文案 hook。</string>
    <string name="mode_cocos_runtime_capture_disabled_desc">不安装运行时 Label 和 LuaBinding 文案 hook。</string>
    <string name="mode_cocos_text_persist_title">写入 text.db</string>
    <string name="mode_cocos_text_persist_enabled_desc">符合条件的 hook 文案会写入目标 text.db。</string>
    <string name="mode_cocos_text_persist_disabled_desc">hook 到的文案不会写入 SQLite。</string>
    <string name="mode_cocos_text_persist_chinese_only_title">仅中文入库</string>
    <string name="mode_cocos_text_persist_chinese_only_enabled_desc">只有包含中文字符的 hook 文案会写入数据库。</string>
    <string name="mode_cocos_text_persist_chinese_only_disabled_desc">所有符合条件的非 ASCII hook 文案都可写入数据库。</string>
    <string name="mode_cocos_text_replacement_delay_title">模拟同步翻译耗时</string>
    <string name="mode_cocos_text_replacement_delay_enabled_desc">Cocos 文本 hook 替换测试文案前会同步等待。</string>
    <string name="mode_cocos_text_replacement_delay_disabled_desc">测试文案会立即替换，不额外等待。</string>
    <string name="mode_cocos_text_replacement_delay_value">延迟毫秒</string>
    <string name="mode_cocos_typewriter_title">突发延迟保护</string>
    <string name="mode_cocos_typewriter_enabled_desc">检测到短时间大量文本 hook 后，跳过后续模拟翻译等待，直接替换测试文案。</string>
    <string name="mode_cocos_typewriter_disabled_desc">每次文本 hook 都走同步替换路径。</string>
    <string name="mode_cocos_typewriter_idle_finalize_ms">突发保持毫秒</string>
